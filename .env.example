# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/movie-ticket-booking
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/movie-ticket-booking
MONGO_URI=mongodb://127.0.0.1:27017/movie-ticket-booking

# ---- Auth ----
# Use a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Needed to register a Cinema Admin (send it as "adminSecret" with role "admin").
# Leave it out to disable admin self-registration completely.
ADMIN_REGISTRATION_SECRET=change-me-admin-secret

# ---- Cinema ----
# Time zone offset used to turn (date + startTime) into a real timestamp.
# Egypt: +02:00 in winter, +03:00 while daylight saving time is active.
CINEMA_TZ_OFFSET=+02:00

# ---- CORS ----
# "*" allows any origin. For a real frontend use a comma-separated list, e.g.
# http://localhost:5173,https://my-frontend.up.railway.app
CORS_ORIGIN=*
